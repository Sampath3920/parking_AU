spring.application.name=smart-parking-backend

spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/smart_parking}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:root}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:}

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

server.port=${PORT:4000}

app.jwt.secret=${JWT_SECRET:SmartCollegeParkingSystemSecretKey2026VeryLong}
app.jwt.expiration-ms=86400000
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://127.0.0.1:5173,24eg105r22.Netlify.app}

app.seed.enabled=${APP_SEED_ENABLED:true}
app.seed.password=${SEED_PASSWORD:ChangeMe@123}
app.payment.manual-amount=50.00
